<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:HabitStreak.Converters"
             x:Class="HabitStreak.Views.ProgressPage"
             Title="Progress">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <Label 
            Text="Habit Streak Calendar"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Margin="0,0,0,20"/>

        <CollectionView Grid.Row="1"
                       ItemsSource="{Binding DateItems}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                Span="7"
                                VerticalItemSpacing="10"
                                HorizontalItemSpacing="5"/>
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                    <Label Text="Sun" Grid.Column="0" HorizontalOptions="Center"/>
                    <Label Text="Mon" Grid.Column="1" HorizontalOptions="Center"/>
                    <Label Text="Tue" Grid.Column="2" HorizontalOptions="Center"/>
                    <Label Text="Wed" Grid.Column="3" HorizontalOptions="Center"/>
                    <Label Text="Thu" Grid.Column="4" HorizontalOptions="Center"/>
                    <Label Text="Fri" Grid.Column="5" HorizontalOptions="Center"/>
                    <Label Text="Sat" Grid.Column="6" HorizontalOptions="Center"/>
                </Grid>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5">
                        <Border BackgroundColor="{Binding IsToday, Converter={StaticResource BoolToColorConverter}}"
                               Stroke="Transparent"
                               StrokeShape="RoundRectangle 5"
                               Padding="5">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Date, StringFormat='{0:dd}'}"
                                       FontSize="16"
                                       HorizontalOptions="Center"/>
                                <Label Text="🔥"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       IsVisible="{Binding IsAchieved}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" 
                Stroke="{StaticResource Primary}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 10"
                Margin="0,20,0,0"
                Padding="20,10">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="🔥" 
                       FontSize="32"
                       VerticalOptions="Center"/>
                <VerticalStackLayout Spacing="0">
                    <Label Text="Current Streak"
                           FontSize="14"
                           TextColor="Gray"/>
                    <Label Text="{Binding CurrentStreak, StringFormat='{0} days'}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>